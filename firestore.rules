rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // V49.4: isolated per-user manual progress backups. No public lists or other-account access.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /player_backups/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['format','progress','updatedAt'])
        && request.resource.data.keys().hasAll(['format','progress','updatedAt'])
        && request.resource.data.format == 1
        && request.resource.data.progress is string
        && request.resource.data.progress.size() >= 10
        && request.resource.data.progress.size() <= 100000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // Keep previous fail-closed policy for all future / privileged collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
