config_version=5

[application]
config/name="THEDEMIANFF LAST ZONE | Aurora V75.41 Casas HUD Ajustes Integrados"
run/main_scene="res://scenes/Boot.tscn"
# 120 is an upper bound, not a performance guarantee.
run/max_fps=120
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/image="res://icon.svg"
boot_splash/bg_color=Color(0.018, 0.021, 0.067, 1)
boot_splash/show_image=true
boot_splash/fullsize=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[display]
# Swappy can request >60Hz on Android 15+ when the display allows it.
window/frame_pacing/android/enable_frame_pacing=true
window/frame_pacing/android/swappy_mode=0
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[physics]
3d/default_gravity=17.5

[layer_names]
3d_physics/layer_1="World and actors"
3d_physics/layer_2="Walkable support"
